# Template for keystore.properties — copy to `keystore.properties` and fill in.
#
#   cp keystore.properties.template keystore.properties && chmod 600 keystore.properties
#
# `keystore.properties` is gitignored and must stay that way: it holds the
# passwords to the release signing key. The keystore file itself lives OUTSIDE
# this repository; storeFile points at it by absolute path.
#
# CI has no such file and reads the same four values from the environment
# instead: ANDROID_KEYSTORE_FILE, ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS,
# ANDROID_KEY_PASSWORD.
#
# With neither file nor environment present, `assembleRelease` still works and
# emits an unsigned APK — a clone without the key is not a broken clone.

storeFile=/absolute/path/to/NoSpam.jks
storePassword=
keyAlias=upload
# Omit keyPassword if the key and the store share one password, which is the
# case for a PKCS12 keystore created by `keytool -genkeypair -storetype PKCS12`.
keyPassword=
