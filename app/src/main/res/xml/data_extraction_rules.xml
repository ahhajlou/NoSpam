<!--
    Nothing leaves the device, by backup or by transfer to a new phone.

    `allowBackup="false"` alone is not enough on Android 12 and later: it stops
    cloud backup but still allows device-to-device transfer, which only these
    rules turn off. What would otherwise travel: nospam.db (spam verdicts and
    sender state keyed by phone number), drafts, per-SIM settings holding phone
    numbers, and an install id that promises to reset on reinstall. Subscription
    ids do not carry over to another phone anyway.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
